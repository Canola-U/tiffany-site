PORT=3000
# Store actual tokens in environment settings or an untracked .env file.
DISCORD_CHANNEL_ID=1566736820396359711
DISCORD_BOT_TOKEN=
# Optional: actual UC... YouTube channel ID if handle discovery fails.
YOUTUBE_CHANNEL_ID=
# Optional: without a key, summaries are explicitly labeled source excerpts.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Set before exposing write endpoints on a public deployment.
WRITE_TOKEN=

# Optional Android push. These belong to the same Firebase project.
FIREBASE_ANDROID_CONFIG_JSON=
# Raw secret; never commit a service account key.
FIREBASE_SERVICE_ACCOUNT_JSON=
